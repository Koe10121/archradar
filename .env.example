# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database & Cache
# Example local Docker URL: postgresql+asyncpg://archradar:archradar@localhost:5432/archradar
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

# CORS & Frontend
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://localhost:8000

# Secrets (leave empty in .env.example; populate in gitignored .env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=
